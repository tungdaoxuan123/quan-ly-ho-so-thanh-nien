# ==============================================================================
# Cấu hình Quản lý hồ sơ thanh niên
# ==============================================================================

# Khóa bí mật dùng cho phiên làm việc Flask Session (Tạo ngẫu nhiên một chuỗi bí mật)
SECRET_KEY=thay_doi_chuoi_bi_mat_ngau_nhien_o_day

# Đường dẫn tệp SQLite lưu trữ thông tin người dùng và phân quyền (mặc định tại thư mục gốc của dự án)
AUTH_DB_PATH=users.db

# Thông tin tài khoản Quản trị viên (Admin) mặc định khi khởi tạo lần đầu
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Mật khẩu khởi tạo ban đầu cho người dùng mới và khi admin đặt lại mật khẩu
DEFAULT_USER_PASSWORD=123456

# Thời hạn phiên đăng nhập (tính theo ngày)
PERMANENT_SESSION_LIFETIME_DAYS=7

# Cấu hình địa chỉ IP và cổng chạy máy chủ ứng dụng
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=8765
FLASK_DEBUG=0
